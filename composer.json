{
    "name": "jgrygierek/batch-entity-import-bundle",
    "type": "symfony-bundle",
    "description": "Importing entities with preview and edit features for Symfony.",
    "keywords": [
        "entity",
        "import",
        "preview",
        "excel",
        "xls",
        "xlsx",
        "csv",
        "ods",
        "Symfony"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jarosław Grygierek",
            "email": "jaroslawgrygierek@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "doctrine/collections": "^2.2|^3.1",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.13|^3.1",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^3.3.1|^4.0",
        "phpoffice/phpspreadsheet": "^5.2.0",
        "symfony/config": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/doctrine-bridge": "^7.4|^8.0",
        "symfony/event-dispatcher-contracts": "^3.5",
        "symfony/form": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/http-foundation": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/options-resolver": "^7.4|^8.0",
        "symfony/property-access": "^7.4|^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/translation": "^7.4|^8.0",
        "symfony/translation-contracts": "^3.5",
        "symfony/twig-bundle": "^7.4|^8.0",
        "symfony/validator": "^7.4|^8.0",
        "twig/twig": "^3.26"
    },
    "require-dev": {
        "dg/bypass-finals": "^v1.8",
        "doctrine/data-fixtures": "^1.7.0|^2.0",
        "doctrine/doctrine-fixtures-bundle": "^3.7.0|^4.3.1",
        "friendsofphp/php-cs-fixer": "^v3.91.3",
        "matthiasnoback/symfony-dependency-injection-test": "^6.1.0",
        "phpstan/phpstan": "^2.1.32",
        "phpstan/phpstan-doctrine": "^2.0.11",
        "phpstan/phpstan-phpunit": "^2.0.8",
        "phpstan/phpstan-symfony": "^2.0.8",
        "phpunit/phpunit": "11.5.56",
        "rector/rector": "2.8.5",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^7.4|^8.0",
        "symfony/dom-crawler": "^7.4|^8.0",
        "symfony/security-bundle": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "suggest": {
        "knplabs/doctrine-behaviors": "Use it for translatable records stored in database"
    },
    "conflict": {
        "knplabs/doctrine-behaviors": "<2.0.8"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "JG\\BatchEntityImportBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JG\\BatchEntityImportBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix -v --dry-run --diff",
        "php-cs-fixer-fix": "vendor/bin/php-cs-fixer fix -v --diff",
        "phpstan": [
            "vendor/bin/phpstan analyse",
            "vendor/bin/phpstan analyse -c phpstan-tests.neon"
        ],
        "rector": "@rector-fix --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "tests": "vendor/bin/phpunit",
        "tests-cov": "vendor/bin/phpunit --coverage-clover=coverage.xml"
    }
}
