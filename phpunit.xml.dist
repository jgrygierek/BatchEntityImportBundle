<?xml version="1.0" encoding="UTF-8"?>
<!-- https://phpunit.de/manual/current/en/appendixes.configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="vendor/autoload.php"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         failOnPhpunitWarning="true"
         failOnDirectDeprecation="true"
>
    <!-- Symfony and Doctrine trigger deprecations with "@", without this option they would not be reported at all.
         Only deprecations triggered by code of the bundle (direct) fail tests, not these of other packages (indirect). -->
    <source ignoreSuppressionOfDeprecations="true">
        <include>
            <directory>./src/</directory>
        </include>
        <!-- helpers which call trigger_error(), so deprecation is reported for code which called deprecated API -->
        <deprecationTrigger>
            <function>trigger_deprecation</function>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::triggerIfCalledFromOutside</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
        </deprecationTrigger>
    </source>
    <php>
        <env name="KERNEL_CLASS" value="JG\BatchEntityImportBundle\Tests\TestKernel"/>
        <env name="SHELL_VERBOSITY" value="-1"/>
    </php>
    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>./tests/</directory>
        </testsuite>
    </testsuites>

    <extensions>
        <bootstrap class="DG\BypassFinals\PHPUnitExtension">
            <!-- fixtures with readonly properties, which have to stay readonly (parameter is supported since dg/bypass-finals 1.11) -->
            <parameter name="denyPaths" value="*/tests/Fixtures/Model/*"/>
        </bootstrap>
    </extensions>
</phpunit>
