<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <title>BatchEntityImportBundle</title>
</head>
<body>
<div>
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {# classes of Bootstrap, the same as in other templates of the bundle ("error" is "danger" in Bootstrap) #}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
</div>
<div>
    {% block batch_entity_import_content %}{% endblock %}
</div>
</body>
</html>
